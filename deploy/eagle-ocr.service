# eagle-ocr systemd 用户服务样例。
#
# 安装：
#   uv tool install --with "paddleocr>=3.7,<3.8" --with "paddlepaddle>=3.3,<3.4" /path/to/eagle-ocr
#   mkdir -p ~/.config/systemd/user ~/.config/eagle-ocr
#   cp deploy/eagle-ocr.service ~/.config/systemd/user/
#   cp deploy/config.example.toml ~/.config/eagle-ocr/config.toml   # 可选
#   systemctl --user daemon-reload
#   systemctl --user enable --now eagle-ocr
#   journalctl --user -u eagle-ocr -f
#
# 想在未登录时也运行：sudo loginctl enable-linger $USER

[Unit]
Description=eagle-ocr: resident PaddleOCR HTTP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = 用户家目录。uv tool install 默认把命令装到 ~/.local/bin。
# 没有配置文件时去掉 --config，全部用默认值（127.0.0.1:8866，cpu，ch）。
ExecStart=%h/.local/bin/eagle-ocr serve --config %h/.config/eagle-ocr/config.toml
# 模型已缓存在 ~/.paddlex 时跳过启动时对模型源的联网检查。
Environment=PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
Restart=on-failure
RestartSec=5
# 模型加载 + 推理比较吃内存；按机器调整或删掉。
MemoryMax=4G
NoNewPrivileges=yes

[Install]
WantedBy=default.target
